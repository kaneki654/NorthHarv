/* ===================================================================
   NorthHarv — UI Design System
   Edit this file with Opus to customize the visual design.
   =================================================================== */

@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap');

/* ── Design tokens ─────────────────────────────────────────────────── */
:root {
  --bg:          #080b12;
  --bg-2:        #0d1117;
  --bg-3:        #161b22;
  --bg-4:        #21262d;
  --fg:          #c9d1d9;
  --fg-2:        #8b949e;
  --fg-3:        #58646f;
  --border:      #30363d;
  --border-2:    #21262d;
  --primary:     #58a6ff;
  --primary-dim: #1f3952;
  --success:     #3fb950;
  --warning:     #d29922;
  --danger:      #f85149;
  --accent:      #58a6ff;
  --critical:    #f85149;
  --high:        #e3733a;
  --medium:      #d29922;
  --low:         #58a6ff;
  --kev:         #f85149;
  --font-sans:   'Inter', system-ui, -apple-system, sans-serif;
  --font-mono:   'JetBrains Mono', 'Fira Code', 'Consolas', monospace;
  --radius:      6px;
  --radius-lg:   10px;
  --shadow:      0 1px 3px rgba(0,0,0,.4), 0 1px 2px rgba(0,0,0,.24);
  --shadow-lg:   0 4px 24px rgba(0,0,0,.5);
}

/* ── Reset & base ──────────────────────────────────────────────────── */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { font-size: 15px; scroll-behavior: smooth; }
body {
  font-family: var(--font-sans);
  background: var(--bg);
  color: var(--fg);
  min-height: 100vh;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}
a { color: var(--primary); text-decoration: none; }
a:hover { text-decoration: underline; }
code, pre, .mono { font-family: var(--font-mono); }

/* ── Layout ─────────────────────────────────────────────────────────── */
.app-shell {
  display: grid;
  grid-template-columns: 220px 1fr;
  grid-template-rows: 56px 1fr;
  grid-template-areas: "nav nav" "side main";
  min-height: 100vh;
}
.topnav {
  grid-area: nav;
  background: var(--bg-2);
  border-bottom: 1px solid var(--border);
  display: flex;
  align-items: center;
  padding: 0 1.5rem;
  gap: 1.5rem;
  position: sticky;
  top: 0;
  z-index: 100;
}
.sidebar {
  grid-area: side;
  background: var(--bg-2);
  border-right: 1px solid var(--border);
  padding: 1rem 0;
  position: sticky;
  top: 56px;
  height: calc(100vh - 56px);
  overflow-y: auto;
}
.main-content {
  grid-area: main;
  padding: 1.5rem;
  min-width: 0;
}

/* ── Topnav ─────────────────────────────────────────────────────────── */
.logo {
  display: flex;
  align-items: center;
  gap: .5rem;
  font-size: 1.1rem;
  font-weight: 700;
  color: var(--fg);
  letter-spacing: -.5px;
  white-space: nowrap;
}
.logo .dot { color: var(--primary); }
.logo .sub { color: var(--fg-2); font-weight: 400; font-size: .8rem; margin-top: 1px; }
.nav-search {
  flex: 1;
  max-width: 600px;
  position: relative;
}
.nav-search input {
  width: 100%;
  background: var(--bg-3);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  color: var(--fg);
  font-family: var(--font-mono);
  font-size: .85rem;
  padding: .45rem .75rem .45rem 2.1rem;
  outline: none;
  transition: border-color .15s;
}
.nav-search input:focus { border-color: var(--primary); }
.nav-search input::placeholder { color: var(--fg-3); }
.nav-search .search-icon {
  position: absolute;
  left: .65rem;
  top: 50%;
  transform: translateY(-50%);
  color: var(--fg-3);
  font-size: .85rem;
  pointer-events: none;
}
.nav-actions { display: flex; align-items: center; gap: .75rem; margin-left: auto; }
.nav-link {
  color: var(--fg-2);
  font-size: .85rem;
  padding: .3rem .5rem;
  border-radius: var(--radius);
  transition: background .15s, color .15s;
  display: flex;
  align-items: center;
  gap: .35rem;
}
.nav-link:hover, .nav-link.active {
  background: var(--bg-4);
  color: var(--fg);
  text-decoration: none;
}

/* ── Sidebar nav ────────────────────────────────────────────────────── */
.sidebar-label {
  font-size: .7rem;
  font-weight: 600;
  letter-spacing: .08em;
  text-transform: uppercase;
  color: var(--fg-3);
  padding: 1rem 1rem .4rem;
}
.sidebar-link {
  display: flex;
  align-items: center;
  gap: .6rem;
  padding: .45rem 1rem;
  color: var(--fg-2);
  font-size: .875rem;
  transition: background .12s, color .12s;
  border-left: 2px solid transparent;
}
.sidebar-link:hover {
  background: var(--bg-3);
  color: var(--fg);
  text-decoration: none;
}
.sidebar-link.active {
  background: var(--bg-3);
  color: var(--primary);
  border-left-color: var(--primary);
}
.sidebar-icon { width: 16px; text-align: center; opacity: .7; }
.sidebar-link.active .sidebar-icon { opacity: 1; }

/* ── Cards ──────────────────────────────────────────────────────────── */
.card {
  background: var(--bg-2);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 1.25rem;
}
.card-title {
  font-size: .75rem;
  font-weight: 600;
  letter-spacing: .06em;
  text-transform: uppercase;
  color: var(--fg-2);
  margin-bottom: .75rem;
  display: flex;
  align-items: center;
  gap: .5rem;
}
.card-title .ct-icon { color: var(--primary); }

/* ── Stat tiles ─────────────────────────────────────────────────────── */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
  gap: 1rem;
  margin-bottom: 1.5rem;
}
.stat-tile {
  background: var(--bg-2);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 1rem 1.25rem;
}
.stat-label { font-size: .75rem; color: var(--fg-2); margin-bottom: .2rem; }
.stat-value { font-size: 1.75rem; font-weight: 700; color: var(--fg); line-height: 1; }
.stat-sub { font-size: .75rem; color: var(--fg-3); margin-top: .2rem; }
.stat-tile.danger  { border-left: 3px solid var(--danger); }
.stat-tile.warning { border-left: 3px solid var(--warning); }
.stat-tile.success { border-left: 3px solid var(--success); }
.stat-tile.primary { border-left: 3px solid var(--primary); }

/* ── Search bar (page-level) ────────────────────────────────────────── */
.search-hero {
  margin-bottom: 1.5rem;
}
.search-wrap {
  display: flex;
  gap: .5rem;
}
.search-input {
  flex: 1;
  background: var(--bg-2);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  color: var(--fg);
  font-family: var(--font-mono);
  font-size: .9rem;
  padding: .6rem .9rem;
  outline: none;
  transition: border-color .15s;
}
.search-input:focus { border-color: var(--primary); }
.search-input::placeholder { color: var(--fg-3); }
.search-examples {
  margin-top: .5rem;
  display: flex;
  gap: .4rem;
  flex-wrap: wrap;
}
.search-chip {
  font-family: var(--font-mono);
  font-size: .75rem;
  background: var(--bg-3);
  border: 1px solid var(--border);
  border-radius: 4px;
  padding: .15rem .5rem;
  color: var(--fg-2);
  cursor: pointer;
  transition: border-color .12s, color .12s;
}
.search-chip:hover { border-color: var(--primary); color: var(--primary); }

/* ── Result rows ─────────────────────────────────────────────────────── */
.result-list { display: flex; flex-direction: column; gap: .5rem; }
.result-row {
  background: var(--bg-2);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: .75rem 1rem;
  display: grid;
  grid-template-columns: 160px 60px 140px 1fr auto;
  gap: .75rem;
  align-items: center;
  transition: border-color .12s;
  cursor: pointer;
}
.result-row:hover { border-color: var(--primary); text-decoration: none; }
.result-ip  { font-family: var(--font-mono); font-size: .875rem; color: var(--primary); }
.result-port { font-family: var(--font-mono); font-size: .875rem; color: var(--fg-2); }
.result-service { font-size: .8rem; color: var(--fg-2); }
.result-meta { font-size: .8rem; color: var(--fg-2); min-width: 0; }
.result-meta .title { color: var(--fg); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.result-badges { display: flex; gap: .3rem; flex-wrap: nowrap; }

/* ── Badges / severity pills ────────────────────────────────────────── */
.badge {
  font-size: .68rem;
  font-weight: 600;
  padding: .15rem .45rem;
  border-radius: 3px;
  letter-spacing: .03em;
  white-space: nowrap;
}
.badge-critical { background: rgba(248,81,73,.15); color: var(--critical); border: 1px solid rgba(248,81,73,.3); }
.badge-high     { background: rgba(227,115,58,.15); color: var(--high);     border: 1px solid rgba(227,115,58,.3); }
.badge-medium   { background: rgba(210,153,34,.15); color: var(--medium);   border: 1px solid rgba(210,153,34,.3); }
.badge-low      { background: rgba(88,166,255,.15); color: var(--low);      border: 1px solid rgba(88,166,255,.3); }
.badge-none     { background: var(--bg-4); color: var(--fg-3);              border: 1px solid var(--border); }
.badge-kev      { background: rgba(248,81,73,.2);  color: #ff6b6b;          border: 1px solid rgba(248,81,73,.4); }
.badge-info     { background: rgba(88,166,255,.12); color: var(--primary);   border: 1px solid rgba(88,166,255,.25); }
.badge-success  { background: rgba(63,185,80,.12); color: var(--success);    border: 1px solid rgba(63,185,80,.25); }

/* ── Port table ─────────────────────────────────────────────────────── */
.port-table { width: 100%; border-collapse: collapse; font-size: .875rem; }
.port-table th {
  text-align: left;
  padding: .5rem .75rem;
  font-size: .7rem;
  font-weight: 600;
  letter-spacing: .07em;
  text-transform: uppercase;
  color: var(--fg-3);
  border-bottom: 1px solid var(--border);
}
.port-table td { padding: .6rem .75rem; border-bottom: 1px solid var(--border-2); vertical-align: top; }
.port-table tr:last-child td { border-bottom: none; }
.port-table tr:hover td { background: rgba(255,255,255,.025); }
.port-num { font-family: var(--font-mono); color: var(--primary); font-weight: 500; }
.banner-cell {
  font-family: var(--font-mono);
  font-size: .78rem;
  color: var(--fg-3);
  max-width: 400px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  cursor: pointer;
}
.banner-cell.expanded { white-space: pre-wrap; overflow: visible; }

/* ── Tabs ───────────────────────────────────────────────────────────── */
.tabs { display: flex; gap: 0; border-bottom: 1px solid var(--border); margin-bottom: 1rem; }
.tab-btn {
  background: none;
  border: none;
  border-bottom: 2px solid transparent;
  color: var(--fg-2);
  cursor: pointer;
  font-family: var(--font-sans);
  font-size: .875rem;
  padding: .6rem 1rem;
  margin-bottom: -1px;
  transition: color .15s, border-color .15s;
}
.tab-btn:hover { color: var(--fg); }
.tab-btn.active { color: var(--primary); border-bottom-color: var(--primary); }
.tab-panel { display: none; }
.tab-panel.active { display: block; }

/* ── Forms ──────────────────────────────────────────────────────────── */
.form-row { display: flex; flex-direction: column; gap: .3rem; margin-bottom: .9rem; }
.form-label { font-size: .8rem; font-weight: 500; color: var(--fg-2); }
.form-input, .form-select, .form-textarea {
  background: var(--bg-3);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  color: var(--fg);
  font-family: var(--font-mono);
  font-size: .875rem;
  padding: .5rem .75rem;
  outline: none;
  transition: border-color .15s;
  width: 100%;
}
.form-input:focus, .form-select:focus, .form-textarea:focus { border-color: var(--primary); }
.form-input::placeholder { color: var(--fg-3); }
.form-hint { font-size: .75rem; color: var(--fg-3); }

/* ── Buttons ────────────────────────────────────────────────────────── */
.btn {
  display: inline-flex;
  align-items: center;
  gap: .4rem;
  border: none;
  border-radius: var(--radius);
  cursor: pointer;
  font-family: var(--font-sans);
  font-size: .875rem;
  font-weight: 500;
  padding: .5rem 1rem;
  transition: background .15s, transform .1s;
  white-space: nowrap;
}
.btn:active { transform: scale(.97); }
.btn-primary { background: var(--primary); color: #000; }
.btn-primary:hover { background: #79b8ff; }
.btn-danger  { background: var(--danger);  color: #fff; }
.btn-danger:hover { background: #ff7b72; }
.btn-ghost {
  background: transparent;
  border: 1px solid var(--border);
  color: var(--fg-2);
}
.btn-ghost:hover { background: var(--bg-3); color: var(--fg); }
.btn-sm { padding: .3rem .65rem; font-size: .8rem; }
.btn-xs { padding: .18rem .45rem; font-size: .72rem; }

/* ── Progress bar ───────────────────────────────────────────────────── */
.progress-wrap {
  background: var(--bg-4);
  border-radius: 100px;
  height: 6px;
  overflow: hidden;
}
.progress-bar {
  height: 100%;
  background: var(--primary);
  border-radius: 100px;
  transition: width .3s ease;
}
.progress-bar.danger { background: var(--danger); }

/* ── Scan terminal / log ────────────────────────────────────────────── */
.scan-log {
  background: #0d0d0d;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  font-family: var(--font-mono);
  font-size: .78rem;
  color: #aad94c;
  padding: .75rem 1rem;
  height: 220px;
  overflow-y: auto;
  line-height: 1.6;
}
.scan-log .log-info  { color: #aad94c; }
.scan-log .log-warn  { color: var(--warning); }
.scan-log .log-error { color: var(--danger); }
.scan-log .log-done  { color: var(--success); }
.scan-log .log-ts    { color: #444; margin-right: .5rem; }

/* ── TLS cert display ───────────────────────────────────────────────── */
.cert-box {
  background: var(--bg-3);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: .75rem 1rem;
  font-size: .82rem;
}
.cert-row { display: flex; gap: 1rem; padding: .25rem 0; border-bottom: 1px solid var(--border-2); }
.cert-row:last-child { border-bottom: none; }
.cert-key { color: var(--fg-2); min-width: 120px; }
.cert-val { color: var(--fg); font-family: var(--font-mono); word-break: break-all; }
.cert-expired { color: var(--danger); font-weight: 600; }
.cert-ok      { color: var(--success); }

/* ── Geo/ASN display ────────────────────────────────────────────────── */
.geo-pill {
  display: inline-flex;
  align-items: center;
  gap: .35rem;
  font-size: .78rem;
  color: var(--fg-2);
}
.flag { font-size: 1rem; }

/* ── Chart container ────────────────────────────────────────────────── */
.chart-box { position: relative; }
.chart-box canvas { max-height: 240px; }

/* ── Page header ────────────────────────────────────────────────────── */
.page-header { margin-bottom: 1.25rem; }
.page-title  { font-size: 1.25rem; font-weight: 700; display: flex; align-items: center; gap: .6rem; }
.page-sub    { font-size: .85rem; color: var(--fg-2); margin-top: .2rem; font-family: var(--font-mono); }
.breadcrumb  { font-size: .8rem; color: var(--fg-3); margin-bottom: .5rem; }
.breadcrumb a { color: var(--fg-2); }

/* ── Host IP hero ───────────────────────────────────────────────────── */
.host-ip {
  font-family: var(--font-mono);
  font-size: 1.5rem;
  font-weight: 700;
  color: var(--fg);
  letter-spacing: -.5px;
}
.host-meta-row { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; margin-top: .4rem; }
.host-org { font-size: .85rem; color: var(--fg-2); }

/* ── CVE list ───────────────────────────────────────────────────────── */
.cve-list { display: flex; flex-direction: column; gap: .3rem; }
.cve-row {
  display: flex;
  align-items: center;
  gap: .6rem;
  padding: .45rem .75rem;
  background: var(--bg-3);
  border-radius: var(--radius);
  font-size: .82rem;
}
.cve-id { font-family: var(--font-mono); font-weight: 500; }
.cve-desc { color: var(--fg-2); flex: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.epss-score { font-family: var(--font-mono); font-size: .78rem; color: var(--fg-3); white-space: nowrap; }

/* ── Enum results table ─────────────────────────────────────────────── */
.status-2xx { color: var(--success); }
.status-3xx { color: var(--primary); }
.status-4xx { color: var(--fg-3); }
.status-5xx { color: var(--danger); }

/* ── Loading skeleton ───────────────────────────────────────────────── */
@keyframes shimmer {
  0%   { background-position: -400px 0; }
  100% { background-position: 400px 0; }
}
.skeleton {
  background: linear-gradient(90deg, var(--bg-3) 25%, var(--bg-4) 50%, var(--bg-3) 75%);
  background-size: 800px 100%;
  animation: shimmer 1.4s infinite;
  border-radius: var(--radius);
}

/* ── Empty state ────────────────────────────────────────────────────── */
.empty-state {
  text-align: center;
  padding: 3rem;
  color: var(--fg-3);
}
.empty-state h3 { font-size: 1rem; color: var(--fg-2); margin-bottom: .4rem; }
.empty-icon { font-size: 2.5rem; margin-bottom: .75rem; opacity: .5; }

/* ── Notification toast ─────────────────────────────────────────────── */
.toast-container { position: fixed; top: 70px; right: 1rem; z-index: 9999; display: flex; flex-direction: column; gap: .4rem; }
.toast {
  background: var(--bg-3);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: .6rem 1rem;
  font-size: .85rem;
  min-width: 260px;
  box-shadow: var(--shadow-lg);
  animation: slideIn .2s ease;
}
.toast.success { border-left: 3px solid var(--success); }
.toast.error   { border-left: 3px solid var(--danger); }
@keyframes slideIn { from { transform: translateX(100%); opacity: 0; } to { transform: none; opacity: 1; } }

/* ── Utilities ──────────────────────────────────────────────────────── */
.mt-1 { margin-top: .25rem; } .mt-2 { margin-top: .5rem; }
.mt-3 { margin-top: .75rem; } .mt-4 { margin-top: 1rem; }
.mb-1 { margin-bottom: .25rem; } .mb-2 { margin-bottom: .5rem; }
.mb-3 { margin-bottom: .75rem; } .mb-4 { margin-bottom: 1rem; }
.flex { display: flex; } .gap-1 { gap: .25rem; } .gap-2 { gap: .5rem; } .gap-3 { gap: .75rem; }
.items-center { align-items: center; }
.justify-between { justify-content: space-between; }
.text-sm  { font-size: .85rem; }
.text-xs  { font-size: .75rem; }
.text-mono { font-family: var(--font-mono); }
.text-muted { color: var(--fg-2); }
.text-dim   { color: var(--fg-3); }
.text-danger { color: var(--danger); }
.text-success { color: var(--success); }
.text-primary { color: var(--primary); }
.w-full { width: 100%; }
.grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
.grid-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1rem; }
.overflow-hidden { overflow: hidden; }
.text-ellipsis { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0,0,0,0); }

/* ── Responsive ─────────────────────────────────────────────────────── */
@media (max-width: 900px) {
  .app-shell {
    grid-template-columns: 1fr;
    grid-template-rows: 56px auto 1fr;
    grid-template-areas: "nav" "side" "main";
  }
  .sidebar { position: static; height: auto; border-right: none; border-bottom: 1px solid var(--border); display: flex; flex-wrap: wrap; padding: .4rem .75rem; }
  .sidebar-label { display: none; }
  .sidebar-link { padding: .35rem .6rem; border-left: none !important; border-bottom: 2px solid transparent; }
  .sidebar-link.active { border-bottom-color: var(--primary); }
  .result-row { grid-template-columns: 1fr auto; }
  .result-port, .result-service { display: none; }
  .grid-2, .grid-3 { grid-template-columns: 1fr; }
  .stats-grid { grid-template-columns: repeat(2, 1fr); }
}
